# Copy to .env for local development. Never commit .env.
# In production set these in Vercel > Project > Settings > Environment Variables.

# Required. Create at https://aistudio.google.com/apikey (server-side only; do NOT prefix with VITE_).
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=MINIMAL        # set empty to omit for models without thinking levels
# CHAT_MAX_OUTPUT_TOKENS=600
# CHAT_TIMEOUT_MS=20000
# CHAT_RATE_LIMIT_PER_MINUTE=8
# CHAT_RATE_LIMIT_PER_HOUR=60
# ALLOWED_ORIGINS=https://your-custom-domain.com   # extra origins; same-origin is always allowed
# API_PORT=3001
